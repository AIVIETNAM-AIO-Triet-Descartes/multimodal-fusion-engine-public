# --- Artifacts & data -------------------------------------------------------
# These trees hold generated bytes, never source. Ignoring the *contents*
# (`data/**`) keeps the directories (and their .gitkeep) re-includable.
data/**
!data/**/
!data/**/.gitkeep
!data/README.md

stores/**
!stores/**/
!stores/**/.gitkeep

# Runtime store used by the web cockpit (see config/btc_b12.yaml).
runtime/

eval/results/**
!eval/results/**/
!eval/results/**/.gitkeep
eval/throughput*.json
eval/results_*/**
eval/merge/**
eval/submissions/**
submissions/**

# Local caches of scripts/query_flat.py and the transport layer (regenerable,
# and the matrix caches exceed GitHub's 100 MB limit).
.cache/
bundle_local/
mfe-data*.zip

# --- Web cockpit state (credentials, sessions, submission log) ---------------
web/accounts.json
web/CREDENTIALS.txt
web/.session_secret
web/suggestions.json
web/dres_submissions.json

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Secrets ----------------------------------------------------------------
.env

# --- Editors / OS -----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
