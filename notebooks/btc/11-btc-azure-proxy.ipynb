  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Bước 2: Khai báo cấu hình\n",
    "Điền thông tin kết nối Azure của bạn vào đây."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "AZURE_CONNECTION_STRING = \"DefaultEndpointsProtocol=https;AccountName=aicvideos;AccountKey=ZLdH5hcKb213WiCzOLCmfLrPRWR3rVkDdlfwV5iXr2snbY9lAMAJc9ZlHm9salxNTAvhcaNVJh0N+ASt+nNulQ==;EndpointSuffix=core.windows.net\"\n",
    "CONTAINER_NAME = \"videos\"\n",
    "\n",
    "# Đổi đường dẫn này thành thư mục chứa video gốc trên Kaggle của bạn (Batch 2)\n",
    "INPUT_VIDEO_DIR = \"/kaggle/input/aic25-btc-b2-v1/videos\" \n",
    "\n",
    "# Nơi lưu file tạm trước khi up lên Azure (sẽ bị xóa ngay sau khi up để trống ổ)\n",
    "TEMP_DIR = \"/kaggle/working/proxy_videos\""
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Bước 3: Hàm xử lý FFmpeg (720p + Fast Start)\n",
    "Hàm này dùng phần cứng GPU `h264_nvenc` để nén video siêu tốc."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import subprocess\n",
    "from pathlib import Path\n",
    "\n",
    "Path(TEMP_DIR).mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "def process_video_ffmpeg(input_path, output_path):\n",
    "    \"\"\"\n",
    "    Ép xuống 720p, bitrate ~1M, gắn cờ faststart, nén bằng GPU h264_nvenc.\n",
    "    Nếu máy không có GPU thì đổi 'h264_nvenc' thành 'libx264'.\n",
    "    \"\"\"\n",
    "    command = [\n",
    "        \"ffmpeg\", \"-y\",             # -y: Ghi đè file nếu có\n",
    "        \"-hwaccel\", \"cuda\",         # Tăng tốc giải mã bằng CUDA\n",
    "        \"-i\", str(input_path),\n",
    "        \"-vf\", \"scale=-2:720\",      # Chiều cao 720p, chiều rộng tự co giãn\n",
    "        \"-c:v\", \"h264_nvenc\",       # Encode bằng lõi GPU của Nvidia\n",
    "        \"-preset\", \"p4\",            # Preset tốc độ cân bằng\n",
    "        \"-b:v\", \"1M\",               # Ép dung lượng hình ảnh xuống thấp\n",
    "        \"-c:a\", \"aac\", \"-b:a\", \"128k\",# Nén âm thanh\n",
    "        \"-movflags\", \"faststart\",   # TỐI QUAN TRỌNG: Dời mục lục lên đầu để tua nhanh\n",
    "        str(output_path)\n",
    "    ]\n",
    "    \n",
    "    try:\n",
    "        subprocess.run(command, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)\n",
    "        return True\n",
    "    except subprocess.CalledProcessError as e:\n",
    "        print(f\"Lỗi FFmpeg: {e.stderr.decode('utf-8', errors='ignore')}\")\n",
    "        return False"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Bước 4: Khởi chạy Upload hàng loạt\n",
    "Vòng lặp quét video -> Nén bằng GPU -> Up Azure -> Xóa file tạm."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from azure.storage.blob import BlobServiceClient\n",
    "import time\n",
    "import glob\n",
    "\n",
    "# Khởi tạo kết nối Azure\n",
    "blob_service_client = BlobServiceClient.from_connection_string(AZURE_CONNECTION_STRING)\n",
    "container_client = blob_service_client.get_container_client(CONTAINER_NAME)\n",
    "\n",
    "# Lọc ra tất cả file mp4\n",
    "video_files = glob.glob(os.path.join(INPUT_VIDEO_DIR, \"*.mp4\"))\n",
    "video_files.sort()\n",
    "print(f\"Tìm thấy {len(video_files)} video cần xử lý.\")\n",
    "\n",
    "for i, input_file in enumerate(video_files, 1):\n",
    "    video_name = os.path.basename(input_file)\n",
    "    temp_file = os.path.join(TEMP_DIR, video_name)\n",
    "    \n",
    "    print(f\"[{i}/{len(video_files)}] Đang nén GPU cho: {video_name} ...\")\n",
    "    start_time = time.time()\n",
    "    \n",
    "    # 1. Nén và tối ưu Video\n",
    "    success = process_video_ffmpeg(input_file, temp_file)\n",
    "    if not success:\n",
    "        print(f\"  -> Bỏ qua {video_name} do lỗi nén.\")\n",
    "        continue\n",
    "        \n",
    "    # 2. Upload lên Azure\n",
    "    print(f\"  -> Đang bơm lên Azure...\")\n",
    "    blob_client = container_client.get_blob_client(video_name)\n",
    "    with open(temp_file, \"rb\") as data:\n",
    "        # overwrite=True để lỡ đứt gánh up lại không bị lỗi\n",
    "        blob_client.upload_blob(data, overwrite=True)\n",
    "        \n",
    "    # 3. Xóa rác, giải phóng ổ cứng Kaggle\n",
    "    os.remove(temp_file)\n",
    "    \n",
    "    elapsed = time.time() - start_time\n",
    "    print(f\"  -> XONG {video_name} (mất {elapsed:.1f} giây).\")\n",
    "\n",
    "print(\"HOÀN TẤT TOÀN BỘ!\")"
   ]
  }
 ],
