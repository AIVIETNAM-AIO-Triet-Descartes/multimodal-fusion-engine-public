    "!pip install azure-storage-blob"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Bước 2: Khai báo cấu hình\n",
    "Điền thông tin kết nối Azure của bạn vào đây."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "AZURE_CONNECTION_STRING = \"DefaultEndpointsProtocol=https;AccountName=aicvideos;AccountKey=ZLdH5hcKb213WiCzOLCmfLrPRWR3rVkDdlfwV5iXr2snbY9lAMAJc9ZlHm9salxNTAvhcaNVJh0N+ASt+nNulQ==;EndpointSuffix=core.windows.net\"\n",
    "CONTAINER_NAME = \"video\"\n",
    "\n",
    "# Đường dẫn tĩnh Batch 1 mà bạn đang dùng\n",
    "TARGET_DIR = \"/kaggle/input/datasets/aresusayhi/ai-challenge-2025/Videos/Videos\"\n",
    "\n",
    "# Nơi lưu file tạm trước khi up lên Azure (sẽ bị xóa ngay sau khi up để trống ổ)\n",
    "TEMP_DIR = \"/kaggle/working/proxy_videos\""
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Bước 3: Hàm xử lý FFmpeg (Fast Start)\n",
    "Hàm này copy giữ nguyên 100% chất lượng gốc, dung lượng gốc. Chỉ chèn cờ Fast Start."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import subprocess\n",
    "from pathlib import Path\n",
    "\n",
    "Path(TEMP_DIR).mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "def process_video_ffmpeg(input_path, output_path):\n",
    "    \"\"\"\n",
    "    Giữ nguyên 100% chất lượng gốc (không giảm dung lượng, không giảm độ phân giải).\n",
    "    Chỉ chèn thêm cờ faststart để sửa lỗi tua video bị đơ.\n",
    "    \"\"\"\n",
    "    command = [\n",
    "        \"ffmpeg\", \"-y\",             # -y: Ghi đè file nếu có\n",
    "        \"-i\", str(input_path),\n",
    "        \"-c\", \"copy\",               # Copy y nguyên luồng hình ảnh/âm thanh gốc, KHÔNG nén lại\n",
    "        \"-movflags\", \"faststart\",   # TỐI QUAN TRỌNG: Dời mục lục lên đầu để tua nhanh\n",
    "        str(output_path)\n",
    "    ]\n",
    "    \n",
    "    try:\n",
    "        subprocess.run(command, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)\n",
    "        return True\n",
    "    except subprocess.CalledProcessError as e:\n",
    "        print(f\"Lỗi FFmpeg: {e.stderr.decode('utf-8', errors='ignore')}\")\n",
    "        return False"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Bước 4: Khởi chạy Upload hàng loạt (Hỗ trợ cả .mov)\n",
    "Truy tìm thư mục con, ghim Fast Start và đẩy thẳng tắp lên Azure."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from azure.storage.blob import BlobServiceClient\n",
    "import time\n",
    "import glob\n",
    "\n",
    "# Khởi tạo kết nối Azure\n",
    "blob_service_client = BlobServiceClient.from_connection_string(AZURE_CONNECTION_STRING)\n",
    "container_client = blob_service_client.get_container_client(CONTAINER_NAME)\n",
    "\n",
    "print(\"1. Đang truy tìm ổ nhóm MP4/MOV...\")\n",
    "vid_dirs = set()\n",
    "# Quét siêu tốc tìm chính xác cái thư mục cuối cùng chứa file video\n",
    "for root, dirs, files in os.walk(TARGET_DIR):\n",
    "    for f in files:\n",
    "        if f.lower().endswith(('.mp4', '.mov')):\n",
    "            vid_dirs.add(root)\n",
    "            break\n",
    "\n",
    "print(f\"👉 Khóa mục tiêu thành công: {len(vid_dirs)} thư mục con. BẮT ĐẦU XỬ LÝ & BƠM LÊN AZURE...\\n\")\n",
    "print(\"==========================================================================\")\n",
    "\n",
    "for i, directory in enumerate(vid_dirs, 1):\n",
    "    print(f\"\\nĐang xử lý thư mục {i}/{len(vid_dirs)}: {directory}\")\n",
    "    \n",
    "    video_files = []\n",
    "    for ext in ('*.mp4', '*.mov', '*.MP4', '*.MOV'):\n",
    "        video_files.extend(glob.glob(os.path.join(directory, ext)))\n",
    "    video_files.sort()\n",
    "    \n",
    "    for v_idx, input_file in enumerate(video_files, 1):\n",
    "        video_name = os.path.basename(input_file)\n",
    "        \n",
    "        # Đảm bảo file up lên luôn có đuôi .mp4 để web dễ đọc\n",
    "        out_name = os.path.splitext(video_name)[0] + \".mp4\"\n",
    "        temp_file = os.path.join(TEMP_DIR, out_name)\n",
    "        \n",
    "        print(f\"  [{v_idx}/{len(video_files)}] Đính Fast Start: {video_name} ... \", end=\"\", flush=True)\n",
    "        start_time = time.time()\n",
    "        \n",
    "        # 1. Đính Fast Start\n",
    "        success = process_video_ffmpeg(input_file, temp_file)\n",
    "        if not success:\n",
    "            print(\"LỖI\")\n",
    "            continue\n",
    "            \n",
    "        # 2. Upload lên Azure\n",
    "        blob_client = container_client.get_blob_client(out_name)\n",
    "        with open(temp_file, \"rb\") as data:\n",
    "            blob_client.upload_blob(data, overwrite=True)\n",
    "            \n",
    "        # 3. Xóa rác, giải phóng ổ cứng Kaggle\n",
    "        os.remove(temp_file)\n",
    "        \n",
    "        elapsed = time.time() - start_time\n",
    "        print(f\"XONG ({elapsed:.1f}s)\")\n",
    "\n",
    "print(\"\\n🎉 HOÀN TẤT TOÀN BỘ! BẠN QUA AZURE F5 LÀ THẤY FILE ĐÃ CHUẨN XỊN RỒI ĐÓ!\")"
   ]
  }
 ],
