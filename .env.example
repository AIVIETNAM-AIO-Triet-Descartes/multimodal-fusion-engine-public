# Chép thành `.env` (đã gitignore). Giao diện đọc file này lúc khởi động —
# `app/submit_lab.py` gọi `load_dotenv` ngay đầu, và `mfe.eval.official` cũng
# vậy từ 28-08. Không có bước `export` nào cả.
#
# ĐỪNG xin file `.env` của Lead. Hai khoá dưới đây khác nhau về bản chất: một
# cái PHẢI dùng chung, một cái mỗi người tự tạo.

# ── BẮT BUỘC — dùng CHUNG cả nhóm ────────────────────────────────────────────
# Ảnh keyframe nằm trên Modal Volume `keyframes-btc` của nhóm, tải về dần vào
# `.cache/keyframes/`. Không có hai biến này thì lưới ảnh trống trơn.
# Xin Lead đúng hai dòng này.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ── NÊN CÓ — mỗi người TỰ TẠO khoá riêng ─────────────────────────────────────
# Tầng online và Cockpit HTML gọi Gemini qua gateway Trammay.
# Xin `TRAMMAY_API_KEY` từ người quản trị Trammay; không đưa khóa vào Git.
#
# `GEMINI_API_KEY` chỉ giữ lại cho các script cũ ngoài Cockpit; web không dùng
# khóa Google trực tiếp khi `TRAMMAY_API_KEY` đã có.
GEMINI_API_KEY=

# Gateway OpenAI-compatible dùng cho QUEST KIS/QA/TRAKE, QA VLM và VLM online.
TRAMMAY_API_KEY=
TRAMMAY_API_KEY2=
MFE_TRAMMAY_BASE_URL=https://llm-gateway.invalid/v1
MFE_TRAMMAY_MODEL=ag/gemini-3.8-flash-high

# Tên model cũ cho các script tương thích; Cockpit dùng model Trammay ở trên.
MFE_GEMINI_VLM_MODEL=gemini-flash-lite-latest

# Biến cũ cho QUEST tương thích; khi có TRAMMAY_API_KEY, QuestClient bỏ qua nó.
MFE_GEMINI_QUEST_MODEL=gemini-flash-lite-latest

# ── NỘP BÀI DRES — chỉ backend đọc, không đưa giá trị lên trình duyệt ────────
user_dres=
pass_dres=
MFE_DRES_BASE_URL=https://eventretrieval.one
# Nếu để trống, web hiển thị danh sách evaluation để chọn.
MFE_DRES_EVALUATION_ID=

# ── KHÔNG CẦN cho việc chạy giao diện ────────────────────────────────────────
# `hf_cross` — đo được ÂM (−0,029 trên 163 câu dev) nên đang tắt.
# HF_TOKEN=
#
# `vlm` qua NVIDIA NIM — NIM chỉ nhận 1 ảnh mỗi request còn rerank cần 20, nên
# đường này thực tế không bao giờ chạy. Xem `rerank_tiers.NVIDIA_MAX_IMAGES`.
# NVIDIA_API_KEY=
#
# Chỉ dùng cho tầng ingest offline, không liên quan giao diện.
# OPENROUTER_API_KEY=
# GITHUB_TOKEN=

# ── Kho video gốc — cho việc TUA VIDEO trên bàn nộp ──────────────────────────
# Bàn nộp cho bấm vào một khung ứng viên, mở video tua quanh nó, rồi thay khung
# vừa tua vào đúng hạng đó. Thiếu biến này thì mọi thứ khác vẫn chạy, chỉ riêng
# hộp "Tua video" hiện hướng dẫn thay vì trình phát.
#
# URL gốc chứa `{video_id}.mp4`. Kèm luôn phần `?...` nếu là SAS token của Azure
# — mã sẽ nối nó vào SAU tên file, đúng thứ blob store ký.
#
# ⚠ SAS CÓ HẠN. Hết hạn thì trình phát im lặng không tải được, không báo lỗi gì.
#   Xin link mới từ người giữ kho (Bảo) và kiểm hạn `se=` trước ngày thi.
# MFE_VIDEO_BASE_URL=https://<tài khoản>.blob.core.windows.net/videos?sp=rl&...
#
# Hoặc, nếu có video trên đĩa: thư mục chứa `{video_id}.mp4`, nhiều thư mục thì
# ngăn bằng `;`. Chế độ này KHÔNG hiện được số khung trực tiếp (trình duyệt
# không đọc `file://` từ trong iframe), phải nhập giây tay.
# MFE_VIDEO_DIR=D:\kho\videos
